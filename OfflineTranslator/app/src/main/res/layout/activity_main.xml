<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_app_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layoutDirection="rtl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_header_gradient">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TriTranslate Offline"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="العربية  •  English  •  فارسی"
                android:textSize="15sp"
                android:textColor="#E0F2FE"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="تصميم: هدير الخفاجي"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FDE68A"
                android:gravity="center" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="جاري تجهيز النماذج المحلية…"
            android:textSize="13sp"
            android:textColor="#334155"
            android:gravity="center" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="7dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#0EA5E9" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/section_bg"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💬 الترجمة المباشرة"
                android:textStyle="bold"
                android:textSize="19sp"
                android:textColor="#0F172A" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="اختر لغة الكلام ولغة الترجمة. بعد التسجيل تبدأ الترجمة والنطق مباشرة."
                android:textSize="13sp"
                android:textColor="#64748B" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Spinner
                    android:id="@+id/sourceLanguageSpinner"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/box_bg"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

                <Button
                    android:id="@+id/swapButton"
                    android:layout_width="54dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="⇄"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0EA5E9" />

                <Spinner
                    android:id="@+id/targetLanguageSpinner"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/box_bg"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />
            </LinearLayout>

            <Button
                android:id="@+id/recordVoiceButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:text="🎤  ابدأ الكلام"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2563EB" />

            <Button
                android:id="@+id/stopRecordButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:text="■ إيقاف واستكمال الترجمة"
                android:textColor="#FFFFFF"
                android:backgroundTint="#DC2626"
                android:enabled="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="النص الذي فهمه التطبيق"
                android:textStyle="bold"
                android:textColor="#334155" />

            <EditText
                android:id="@+id/sourceText"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/box_bg"
                android:gravity="top|start"
                android:padding="13dp"
                android:textSize="17sp"
                android:textColor="#0F172A"
                android:hint="اكتب هنا أو استخدم الميكروفون…"
                android:inputType="textMultiLine|textCapSentences" />

            <Button
                android:id="@+id/translateButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:text="ترجم الآن"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0F766E" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="الترجمة"
                android:textStyle="bold"
                android:textColor="#334155" />

            <EditText
                android:id="@+id/translatedText"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/box_bg"
                android:gravity="top|start"
                android:padding="13dp"
                android:textSize="17sp"
                android:textColor="#0F172A"
                android:focusable="false"
                android:inputType="textMultiLine" />

            <Button
                android:id="@+id/speakButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="🔊 نطق الترجمة"
                android:textColor="#FFFFFF"
                android:backgroundTint="#7C3AED" />

            <TextView
                android:id="@+id/understandingHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="إذا لم يفهم الكلام بوضوح سيطلب منك إعادة النطق."
                android:textColor="#92400E"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/section_bg"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💱 تحويل العملات"
                android:textStyle="bold"
                android:textSize="19sp"
                android:textColor="#0F172A" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="أدخل سعر السوق بنفسك. التطبيق لا يحتاج إنترنت ولا يغيّر السعر تلقائيًا."
                android:textSize="13sp"
                android:textColor="#64748B" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="1 دولار = كم دينار عراقي؟" android:textColor="#334155" />
            <EditText android:id="@+id/usdIqdRate" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="4dp" android:background="@drawable/box_bg" android:padding="12dp" android:inputType="numberDecimal" android:hint="مثال: 1500" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="1 دولار = كم ريال إيراني؟" android:textColor="#334155" />
            <EditText android:id="@+id/usdIrrRate" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="4dp" android:background="@drawable/box_bg" android:padding="12dp" android:inputType="numberDecimal" android:hint="أدخل سعر السوق بالريال" />

            <Button android:id="@+id/saveRatesButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="9dp" android:text="💾 حفظ سعر الصرف على الهاتف" android:textColor="#FFFFFF" android:backgroundTint="#0F766E" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="المبلغ" android:textStyle="bold" android:textColor="#334155" />
            <EditText android:id="@+id/moneyAmount" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="5dp" android:background="@drawable/box_bg" android:padding="12dp" android:inputType="text" android:hint="مثال: 25000000 ريال" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <Button android:id="@+id/parseRialButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="ريال" android:backgroundTint="#0284C7" android:textColor="#FFFFFF" />
                <Space android:layout_width="5dp" android:layout_height="1dp" />
                <Button android:id="@+id/parseTomanButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="تومان" android:backgroundTint="#0284C7" android:textColor="#FFFFFF" />
                <Space android:layout_width="5dp" android:layout_height="1dp" />
                <Button android:id="@+id/parseIqdButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="دينار" android:backgroundTint="#0284C7" android:textColor="#FFFFFF" />
                <Space android:layout_width="5dp" android:layout_height="1dp" />
                <Button android:id="@+id/parseUsdButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="$" android:backgroundTint="#0284C7" android:textColor="#FFFFFF" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="إدخال المبلغ بالصوت" android:textColor="#475569" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp">
                <Button android:id="@+id/moneyVoiceArButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="🎤 عربي" />
                <Space android:layout_width="5dp" android:layout_height="1dp" />
                <Button android:id="@+id/moneyVoiceFaButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="🎤 فارسی" />
                <Space android:layout_width="5dp" android:layout_height="1dp" />
                <Button android:id="@+id/moneyVoiceEnButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="🎤 EN" />
            </LinearLayout>

            <TextView
                android:id="@+id/moneyResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/box_bg"
                android:padding="13dp"
                android:text="ستظهر المقارنة بالريال والدينار والدولار هنا."
                android:textSize="16sp"
                android:textColor="#0F172A" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/section_bg"
            android:padding="16dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📷 تصوير السعر وحساب الأوراق" android:textStyle="bold" android:textSize="19sp" android:textColor="#0F172A" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="صوّر السعر المكتوب. سيقرأ التطبيق الرقم ويقارنه بالدينار والدولار ثم يحسب عدد الأوراق من الفئة التي تختارها." android:textSize="13sp" android:textColor="#64748B" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="9dp">
                <Button android:id="@+id/cameraButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="📷 تصوير السعر" android:textColor="#FFFFFF" android:backgroundTint="#2563EB" />
                <Space android:layout_width="7dp" android:layout_height="1dp" />
                <Button android:id="@+id/galleryButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="🖼 صورة محفوظة" android:textColor="#FFFFFF" android:backgroundTint="#7C3AED" />
            </LinearLayout>

            <ImageView
                android:id="@+id/priceImage"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/box_bg"
                android:scaleType="centerInside"
                android:contentDescription="صورة السعر" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="فئة الورقة التي تريد استخدامها — بالريال" android:textColor="#334155" />
            <EditText android:id="@+id/noteDenomination" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="4dp" android:background="@drawable/box_bg" android:padding="12dp" android:inputType="number" android:hint="مثال: 500000" />

            <Button android:id="@+id/banknoteCountButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="احسب عدد الأوراق المطلوبة" android:textColor="#FFFFFF" android:backgroundTint="#EA580C" />

            <TextView
                android:id="@+id/ocrResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/box_bg"
                android:padding="13dp"
                android:text="لم يتم تصوير سعر بعد."
                android:textColor="#0F172A"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🔒 لا توجد صلاحية إنترنت داخل التطبيق. أسعار الصرف تدخلها أنت يدويًا."
            android:textSize="12sp"
            android:textColor="#64748B"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="28dp"
            android:text="© 2026 • تصميم وبرمجة: هدير الخفاجي"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
