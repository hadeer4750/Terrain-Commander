<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="#111827" android:layoutDirection="rtl">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LinkSave" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:gravity="center" />
<EditText android:id="@+id/urlInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:hint="https://example.com/video.mp4" android:inputType="textUri" android:minHeight="64dp" android:padding="14dp" android:textColor="#111827" android:textColorHint="#6B7280" android:background="#FFFFFF" />
<Button android:id="@+id/pasteButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="لصق الرابط" />
<Button android:id="@+id/checkButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="فحص الرابط" />
<TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:padding="14dp" android:text="جاهز" android:textColor="#E5E7EB" android:background="#1F2937" />
<Button android:id="@+id/downloadButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:text="تنزيل إلى الهاتف" android:textStyle="bold" />
</LinearLayout>
